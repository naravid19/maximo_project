# Django Secret Key (REQUIRED for production)
# Generate a new key with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=your-secret-key-here-replace-in-production

# Debug Mode (set to False in production)
DJANGO_DEBUG=True

# Allowed Hosts (comma-separated)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# CSRF Trusted Origins (comma-separated, for ngrok or production)
CSRF_TRUSTED_ORIGINS=

# Database URL (optional, defaults to SQLite)
# DATABASE_URL=postgres://user:password@localhost:5432/dbname
